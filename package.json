{
  "name": "watch-file-cache",
  "version": "0.0.0",
  "description": "Cache information associated with a file, invalidating the cache entry if the file changes",
  "main": "lib/index.js",
  "files": [
    "lib"
  ],
  "scripts": {
    "pretest": "npm run build",
    "test": "ts-mocha -p test/tsconfig.json",
    "lint": "eslint .",
    "build": "npm run lint && tsc",
    "precoverage": "npm run build -- --inlineSourceMap",
    "coverage": "c8 ts-mocha -p test/tsconfig.json",
    "postcoverage": "tsc",
    "docs": "typedoc",
    "ci": "npm run coverage && npm run docs"
  },
  "keywords": [
    "file",
    "watch",
    "cache"
  ],
  "author": "Joe Hildebrand <joe-github@cursive.net>",
  "license": "MIT",
  "devDependencies": {
    "@peggyjs/eslint-config": "^6.0.13",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "c8": "^11.0.0",
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.2",
    "eslint": "^10.1.0",
    "eslint-plugin-eslint-plugin": "^7.3.2",
    "eslint-plugin-mocha": "^11.2.0",
    "mocha": "^11.7.5",
    "ts-mocha": "^11.1.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "mocha>diff": "~8.0.3",
      "mocha>serialize-javascript": "~7.0.4"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
